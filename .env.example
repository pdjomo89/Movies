PORT=3000
# Used to sign short-lived streaming URLs. Set a long random value in production.
APP_SECRET=change-me-to-a-long-random-string
DB_PATH=data/mboa.db
VIDEO_DIR=storage/videos
# Pay-per-view windows
RENTAL_HOURS=48
SEASON_PASS_DAYS=30
SEASON_PASS_DISCOUNT=0.2
# Seeded admin account (created on first boot only)
ADMIN_EMAIL=admin@mboareels.cm
ADMIN_PASSWORD=mboa-admin-2026
# Set to true behind HTTPS
SECURE_COOKIES=false
